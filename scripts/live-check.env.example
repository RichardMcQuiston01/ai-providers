# Settings for `bun run live-check`. Copy to .env (git-ignored) and fill in
# only the providers you want to try; the rest are skipped.
# Paid providers cost real money: one text call or one image edit each.
# Every variable is explained in CONFIGURATION.md.

# Local, free (hosts must be this machine or a machine you name here)
OLLAMA_MODEL=
OLLAMA_HOST=
LMSTUDIO_HOST=
LMSTUDIO_MODEL=
VLLM_HOST=
VLLM_MODEL=
LLAMACPP_HOST=
LLAMACPP_MODEL=
SDWEBUI_HOST=
SDWEBUI_MODEL=
COMFYUI_WORKFLOWS=
COMFYUI_MODE=
COMFYUI_HOST=

# Hosted text and image
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Hosted image only
REPLICATE_API_TOKEN=
FAL_KEY=
BFL_API_KEY=
STABILITY_API_KEY=

# Optional model overrides (the library's defaults are used when empty)
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
CLAUDE_TEXT_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
GROK_TEXT_MODEL=
GROK_IMAGE_MODEL=
OPENROUTER_MODEL=
REPLICATE_MODEL=
FAL_MODEL=
BFL_MODEL=
STABILITY_MODEL=
