        "default": "./dist/sdwebui.cjs"
      }
    },
    "./providers": {
      "import": {
        "types": "./dist/providers.d.ts",
        "default": "./dist/providers.js"
      },
      "require": {
        "types": "./dist/providers.d.cts",
        "default": "./dist/providers.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "live-check": "bun run scripts/live-check.ts",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "peerDependencies": {
    "@richardmcquiston01/gemini-icon-gen": ">=0.3.0 <1",
    "@anthropic-ai/sdk": ">=0.133.0 <1",
    "openai": ">=7.34.0 <8"
  },
  "peerDependenciesMeta": {
    "@richardmcquiston01/gemini-icon-gen": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@richardmcquiston01/gemini-icon-gen": "^0.3.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "openai": "^7.34.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
