{
  "name": "@richardmcquiston01/ai-providers",
  "version": "0.5.0",
  "description": "Swappable AI providers for TypeScript: one small interface for text and image generation, with Ollama, ComfyUI, Replicate, fal, Black Forest Labs and Stability AI adapters, a local Stable Diffusion web UI adapter, and Gemini, Claude, OpenAI and Grok (optional peers). Functions return Results instead of throwing; the core is runtime-neutral.",
  "keywords": [
    "ai",
    "llm",
    "ollama",
    "gemini",
    "claude",
    "openai",
    "replicate",
    "fal",
    "flux",
    "stable-diffusion",
    "automatic1111",
    "grok",
    "openrouter",
    "llama-cpp",
    "vllm",
    "lm-studio",
    "comfyui",
    "image-generation",
    "text-generation",
    "provider",
    "adapter",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston (https://richardmcquiston.com/)",
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  },
  "homepage": "https://github.com/RichardMcQuiston01/ai-providers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ai-providers.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/ai-providers/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ollama": [
        "./dist/ollama.d.cts"
      ],
      "comfyui": [
        "./dist/comfyui.d.cts"
      ],
      "node": [
        "./dist/node.d.cts"
      ],
      "gemini": [
        "./dist/gemini.d.cts"
      ],
      "claude": [
        "./dist/claude.d.cts"
      ],
      "openai": [
        "./dist/openai.d.cts"
      ],
      "replicate": [
        "./dist/replicate.d.cts"
      ],
      "grok": [
        "./dist/grok.d.cts"
      ],
      "openai-compatible": [
        "./dist/openai-compatible.d.cts"
      ],
      "fal": [
        "./dist/fal.d.cts"
      ],
      "bfl": [
        "./dist/bfl.d.cts"
      ],
      "stability": [
        "./dist/stability.d.cts"
      ],
      "sdwebui": [
        "./dist/sdwebui.d.cts"
      ],
      "providers": [
        "./dist/providers.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ollama": {
      "import": {
        "types": "./dist/ollama.d.ts",
        "default": "./dist/ollama.js"
      },
      "require": {
        "types": "./dist/ollama.d.cts",
        "default": "./dist/ollama.cjs"
      }
    },
    "./comfyui": {
      "import": {
        "types": "./dist/comfyui.d.ts",
        "default": "./dist/comfyui.js"
      },
      "require": {
        "types": "./dist/comfyui.d.cts",
        "default": "./dist/comfyui.cjs"
      }
    },
    "./gemini": {
      "import": {
        "types": "./dist/gemini.d.ts",
        "default": "./dist/gemini.js"
