{
  "name": "@richardmcquiston01/ai-providers",
  "version": "0.1.0",
  "description": "Swappable AI providers for TypeScript: one small interface for text and image generation, with local Ollama and ComfyUI adapters. Functions return Results instead of throwing; the core is runtime-neutral.",
  "keywords": [
    "ai",
    "llm",
    "ollama",
    "comfyui",
    "image-generation",
    "text-generation",
    "provider",
    "adapter",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston (https://richardmcquiston.com/)",
  "homepage": "https://github.com/RichardMcQuiston01/ai-providers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/ai-providers.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/ai-providers/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ollama": [
        "./dist/ollama.d.cts"
      ],
      "comfyui": [
        "./dist/comfyui.d.cts"
      ],
      "node": [
        "./dist/node.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ollama": {
      "import": {
        "types": "./dist/ollama.d.ts",
        "default": "./dist/ollama.js"
      },
      "require": {
        "types": "./dist/ollama.d.cts",
        "default": "./dist/ollama.cjs"
      }
    },
    "./comfyui": {
      "import": {
        "types": "./dist/comfyui.d.ts",
        "default": "./dist/comfyui.js"
      },
      "require": {
        "types": "./dist/comfyui.d.cts",
        "default": "./dist/comfyui.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
