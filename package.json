      }
    },
    "./fal": {
      "import": {
        "types": "./dist/fal.d.ts",
        "default": "./dist/fal.js"
      },
      "require": {
        "types": "./dist/fal.d.cts",
        "default": "./dist/fal.cjs"
      }
    },
    "./bfl": {
      "import": {
        "types": "./dist/bfl.d.ts",
        "default": "./dist/bfl.js"
      },
      "require": {
        "types": "./dist/bfl.d.cts",
        "default": "./dist/bfl.cjs"
      }
    },
    "./stability": {
      "import": {
        "types": "./dist/stability.d.ts",
